---
import BaseLayout from '../layouts/BaseLayout.astro'; import { company } from '../data/company'; const base=import.meta.env.BASE_URL;
---
<BaseLayout title="首页"><header class="bg-slate-900 text-white"><div class="max-w-6xl mx-auto px-6 py-24 text-center"><h1 class="text-4xl md:text-5xl font-bold mb-4">{company.tagline}</h1><p class="text-lg text-slate-300 max-w-2xl mx-auto">以严谨的量化与基本面研究，为机构与高净值客户提供宏观策略、行业分析与资产配置解决方案。</p><a href={base+'research/'} class="inline-block mt-8 bg-amber-500 text-slate-900 font-semibold px-6 py-3 rounded-lg">查看最新研究</a></div></header><section class="max-w-6xl mx-auto px-6 py-16"><h2 class="text-2xl font-bold mb-8 text-center">核心业务</h2><div class="grid md:grid-cols-3 gap-8">{['宏观策略研究','行业与个股研究','资产配置咨询'].map(x=><div class="bg-white rounded-xl shadow p-6"><h3 class="font-semibold text-lg">{x}</h3></div>)}</div></section></BaseLayout>
