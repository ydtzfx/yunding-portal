---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company } from '../data/company';
import { withBase } from '../lib/paths';
---
<BaseLayout title="首页" description="芸鼎投资研究院发布宏观策略、行业研究与资产配置相关研究内容。">
  <section class="relative overflow-hidden bg-ink-950 text-white">
    <div class="absolute inset-0 opacity-30" aria-hidden="true" style="background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);background-size:48px 48px"></div>
    <div class="institution-container relative grid gap-14 py-20 md:grid-cols-[1.15fr_.85fr] md:py-28">
      <div>
        <div class="institution-eyebrow !text-gold-400 before:!bg-gold-400">Independent Research Publishing</div>
        <h1 class="mt-6 max-w-3xl font-serif text-5xl font-bold leading-[1.15] tracking-tight md:text-7xl">{company.tagline}</h1>
        <p class="mt-7 max-w-2xl text-base leading-8 text-white/65 md:text-lg">围绕宏观政策、行业趋势与资产配置，发布可追溯来源、明确事实边界与风险假设的研究内容。</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={withBase('research/')} class="bg-gold-400 px-5 py-3 text-sm font-semibold text-ink-950 transition hover:bg-[#d4b57d]">进入研究库</a>
          <a href={withBase('about/')} class="border border-white/20 px-5 py-3 text-sm font-semibold text-white transition hover:border-white/40 hover:bg-white/5">了解发布原则</a>
        </div>
      </div>
      <aside class="border border-white/12 bg-white/[.04] p-7 backdrop-blur-sm">
        <div class="text-[11px] font-semibold uppercase tracking-[.18em] text-gold-400">Publication Standard</div>
        <dl class="mt-7 grid gap-6 text-sm">
          <div><dt class="text-white/45">01 / Evidence</dt><dd class="mt-1 font-medium text-white">关键事实与数据可追溯来源</dd></div>
          <div><dt class="text-white/45">02 / Identity</dt><dd class="mt-1 font-medium text-white">报告编号、作者与日期明确</dd></div>
          <div><dt class="text-white/45">03 / Risk</dt><dd class="mt-1 font-medium text-white">事实、判断与风险情景分离</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="institution-container py-18 md:py-24">
    <div class="mb-10 max-w-2xl">
      <div class="institution-eyebrow">Research Scope</div>
      <h2 class="mt-4 font-serif text-3xl font-bold text-ink-950 md:text-4xl">研究方向</h2>
      <p class="mt-4 leading-7 text-slate-600">以公开可核验信息为基础，建立从宏观环境到行业与资产配置的研究框架。</p>
    </div>
    <div class="grid gap-px bg-[#d8d2c8] md:grid-cols-3">
      {[
        ['01','宏观策略研究','货币政策、财政条件、流动性与跨资产宏观变量。'],
        ['02','行业与公司研究','产业结构、竞争格局、公司基本面与关键驱动因素。'],
        ['03','资产配置研究','风险溢价、相关性、情景分析与组合层面的配置框架。']
      ].map(([n,title,desc])=><div class="bg-paper-50 p-7 md:p-8">
        <div class="font-serif text-sm text-gold-700">{n}</div>
        <h3 class="mt-5 font-serif text-xl font-bold text-ink-950">{title}</h3>
        <p class="mt-3 text-sm leading-7 text-slate-600">{desc}</p>
      </div>)}
    </div>
  </section>
</BaseLayout>
