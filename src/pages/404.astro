---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---
<BaseLayout title="页面未找到" description="请求的页面不存在或已移动。">
  <section class="institution-container py-24 text-center">
    <div class="font-serif text-7xl text-gold-700">404</div>
    <h1 class="mt-5 font-serif text-3xl font-bold text-ink-950">页面未找到</h1>
    <p class="mx-auto mt-4 max-w-lg text-sm leading-7 text-slate-600">请求的页面不存在、已移动，或当前尚未公开。</p>
    <div class="mt-8 flex justify-center gap-3">
      <a class="bg-ink-950 px-5 py-3 text-sm font-semibold text-white" href={withBase()}>返回首页</a>
      <a class="border border-[#cfc8bc] px-5 py-3 text-sm font-semibold text-ink-900" href={withBase('research/')}>浏览研究</a>
    </div>
  </section>
</BaseLayout>
