---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchCard from '../../components/ResearchCard.astro';
import { withBase } from '../../lib/paths';
const entries=(await getCollection('research',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const categories=[...new Set(entries.map(e=>e.data.category))].sort();
---
<BaseLayout title="研究观点" description="芸鼎投资研究院研究观点、宏观策略与资产配置研究。">
  <section class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-bold mb-4">研究观点</h1>
    <div class="flex flex-wrap gap-3 mb-8">
      {categories.map(category=><a class="text-sm text-slate-600 hover:text-slate-900" href={withBase('research/category/'+encodeURIComponent(category)+'/')}>{category}</a>)}
      <a class="text-sm text-slate-600 hover:text-slate-900" href={withBase('research/archive/')}>研究归档</a>
    </div>
    {entries.length===0?<p class="text-slate-600">暂无已发布研究内容。</p>:<div class="grid md:grid-cols-2 gap-6">{entries.map(entry=>
      <ResearchCard title={entry.data.title} category={entry.data.category} summary={entry.data.summary}
        reportNumber={entry.data.reportNumber} date={entry.data.date}
        href={withBase('research/'+entry.id+'/')}/>
    )}</div>}
  </section>
</BaseLayout>
