---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchCard from '../../components/ResearchCard.astro';
const entries=(await getCollection('research',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const base=import.meta.env.BASE_URL;
---
<BaseLayout title="研究观点"><section class="max-w-5xl mx-auto px-6 py-16"><h1 class="text-3xl font-bold mb-8">研究观点</h1>{entries.length===0?<p class="text-slate-600">暂无已发布研究内容。</p>:<div class="grid md:grid-cols-2 gap-6">{entries.map(entry=><ResearchCard title={entry.data.title} category={entry.data.category} summary={entry.data.summary} href={base+'research/'+entry.id+'/'}/>)}</div>}</section></BaseLayout>
