---
import { render } from 'astro:content';
import ResearchLayout from '../../layouts/ResearchLayout.astro';
import RelatedResearch from '../../components/RelatedResearch.astro';
import {
  getAuthors,
  getAuthorForResearch,
  getPublishedResearch,
  getRelatedResearch,
  type PublishedResearchEntry,
} from '../../lib/research';

export async function getStaticPaths(){
  const entries=await getPublishedResearch();
  return entries.map(entry=>({params:{id:entry.id},props:{entry}}));
}

const {entry}=Astro.props as {entry:PublishedResearchEntry};
const {Content}=await render(entry);
const [authors,published]=await Promise.all([getAuthors(),getPublishedResearch()]);
const author=getAuthorForResearch(entry,authors);
const relatedEntries=getRelatedResearch(entry,published);
---
<ResearchLayout entry={entry} author={author}>
  <Content/>
</ResearchLayout>
<RelatedResearch entries={relatedEntries}/>
