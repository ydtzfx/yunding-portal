---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ResearchCard from '../../../components/ResearchCard.astro';
import { withBase } from '../../../lib/paths';
import { getPublishedResearch, getResearchCategories } from '../../../lib/research';

export async function getStaticPaths(){
  const entries=await getPublishedResearch();
  const categories=getResearchCategories(entries);
  return categories.map(category=>({
    params:{category},
    props:{category,entries:entries.filter(entry=>entry.data.category===category)}
  }));
}
const {category,entries}=Astro.props;
---
<BaseLayout title={category+'研究'} description={category+'研究文章归档'}>
  <header class="page-header">
    <div class="page-header-inner">
      <div class="institution-eyebrow">Research Category</div>
      <h1 class="page-title">{category}</h1>
      <p class="page-intro">该分类共收录 {entries.length} 篇正式研究。报告按首次发布日期倒序排列。</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a class="button-primary" href={withBase('research/')}>返回研究库</a>
        <a class="button-secondary" href={withBase('research/archive/')}>研究归档</a>
      </div>
    </div>
  </header>
  <section class="institution-container py-12 md:py-16">
    <div class="grid gap-6 md:grid-cols-2">{entries.map(entry=>
      <ResearchCard entry={entry} href={withBase('research/'+entry.id+'/')}/>
    )}</div>
  </section>
</BaseLayout>
