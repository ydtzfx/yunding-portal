---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ResearchCard from '../../../components/ResearchCard.astro';
import { withBase } from '../../../lib/paths';
export async function getStaticPaths(){
  const entries=await getCollection('research',({data})=>!data.draft);
  const categories=[...new Set(entries.map(e=>e.data.category))];
  return categories.map(category=>({params:{category},props:{category,entries:entries.filter(e=>e.data.category===category)}}));
}
const {category,entries}=Astro.props;
---
<BaseLayout title={category+'研究'} description={category+'研究文章归档'}>
  <section class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-bold mb-8">{category}</h1>
    <div class="grid md:grid-cols-2 gap-6">{entries.map(entry=>
      <ResearchCard title={entry.data.title} category={entry.data.category} summary={entry.data.summary}
        reportNumber={entry.data.reportNumber} date={entry.data.date}
        href={withBase('research/'+entry.id+'/')}/>
    )}</div>
  </section>
</BaseLayout>
