---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ResearchCard from '../../../components/ResearchCard.astro';
import { withBase } from '../../../lib/paths';

export async function getStaticPaths(){
  const authors=await getCollection('authors');
  return authors.map(author=>({params:{id:author.id},props:{author}}));
}
const {author}=Astro.props;
const entries=(await getCollection('research',({data})=>!data.draft && data.authorId===author.id))
  .sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<BaseLayout title={author.data.name} description={author.data.bio}>
  <header class="page-header">
    <div class="page-header-inner">
      <div class="institution-eyebrow">Author Profile</div>
      <div class="mt-5 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[.12em] text-gold-700">{author.data.role}</p>
          <h1 class="mt-3 font-serif text-4xl font-bold text-ink-950 md:text-5xl">{author.data.name}</h1>
          <p class="page-intro">{author.data.bio}</p>
        </div>
        <div class="border border-[#d8d2c8] bg-paper-50 px-6 py-5 text-center">
          <strong class="block font-serif text-3xl text-ink-950">{entries.length}</strong>
          <span class="text-xs text-slate-500">已发布研究</span>
        </div>
      </div>
    </div>
  </header>

  <section class="institution-container py-12 md:py-16">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
      <div>
        <div class="institution-eyebrow">Published Research</div>
        <h2 class="mt-3 font-serif text-2xl font-bold text-ink-950">已发布研究</h2>
      </div>
      <a class="institution-link text-sm font-semibold" href={withBase('research/')}>浏览全部研究 →</a>
    </div>
    {entries.length>0
      ? <div class="grid gap-6 md:grid-cols-2">{entries.map(entry=>
          <ResearchCard title={entry.data.title} category={entry.data.category} summary={entry.data.summary}
            reportNumber={entry.data.reportNumber} date={entry.data.date}
            href={withBase('research/'+entry.id+'/')}/>
        )}</div>
      : <p class="border border-[#d8d2c8] bg-white p-6 text-sm text-slate-600">当前暂无已发布研究。</p>}
  </section>
</BaseLayout>
