---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';

const entries=(await getCollection('research',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const groups=Object.groupBy(entries,e=>String(e.data.date.getFullYear()));
---
<BaseLayout title="研究归档" description="按年份浏览芸鼎投资研究院已发布研究。">
  <header class="page-header">
    <div class="page-header-inner">
      <div class="institution-eyebrow">Research Archive</div>
      <h1 class="page-title">研究归档</h1>
      <p class="page-intro">按首次发布日期归档全部正式研究。报告的后续实质修订通过详情页 Updated 日期记录。</p>
      <div class="mt-7"><a class="button-secondary" href={withBase('research/')}>返回研究库</a></div>
    </div>
  </header>

  <section class="institution-container max-w-5xl py-12 md:py-16">
    {Object.entries(groups).sort(([a],[b])=>Number(b)-Number(a)).map(([year,items])=>
      <section class="mb-14 last:mb-0">
        <div class="mb-4 flex items-end justify-between border-b border-[#bfb7aa] pb-3">
          <h2 class="font-serif text-3xl font-bold text-ink-950">{year}</h2>
          <span class="text-xs text-slate-500">{items?.length ?? 0} 篇</span>
        </div>
        <div>{items?.map(entry=>
          <article class="archive-row">
            <time class="text-xs font-semibold tracking-wide text-slate-400" datetime={entry.data.date.toISOString()}>{entry.data.date.toISOString().slice(0,10)}</time>
            <div>
              <a class="font-serif text-lg font-bold leading-7 text-ink-950 hover:text-gold-700" href={withBase('research/'+entry.id+'/')}>{entry.data.title}</a>
              <div class="mt-1 flex flex-wrap gap-x-3 text-xs text-slate-500">
                <span>{entry.data.category}</span>
                {entry.data.reportNumber && <span>{entry.data.reportNumber}</span>}
              </div>
            </div>
            <a class="text-xs font-semibold text-ink-800 hover:text-gold-700" href={withBase('research/'+entry.id+'/')}>阅读全文 →</a>
          </article>
        )}</div>
      </section>
    )}
  </section>
</BaseLayout>
