---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro';
const entries=(await getCollection('research',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()); const groups=Object.groupBy(entries,e=>String(e.data.date.getFullYear())); const base=import.meta.env.BASE_URL;
---
<BaseLayout title="研究归档"><section class="max-w-4xl mx-auto px-6 py-16"><h1 class="text-3xl font-bold mb-8">研究归档</h1>{Object.entries(groups).sort(([a],[b])=>Number(b)-Number(a)).map(([year,items])=><section class="mb-10"><h2 class="text-xl font-semibold mb-4">{year}</h2><ul class="space-y-3">{items?.map(entry=><li><a class="hover:underline" href={base+'research/'+entry.id+'/'}>{entry.data.date.toISOString().slice(0,10)} · {entry.data.title}</a></li>)}</ul></section>)}</section></BaseLayout>
