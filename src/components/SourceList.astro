---
interface Source { title:string; publisher:string; url:string; date?:string; accessed?:string }
interface Props { sources:Source[] }
const {sources}=Astro.props;
---
{sources.length>0 && <section class="mt-12 pt-8 border-t border-slate-200" aria-labelledby="references-heading">
  <h2 id="references-heading" class="text-xl font-semibold mb-4">资料来源</h2>
  <ol class="list-decimal pl-5 space-y-3 text-sm text-slate-600">
    {sources.map((source,index)=><li id={'ref-'+(index+1)}>
      <span class="font-medium text-slate-800">{source.publisher}</span>
      {' — '}
      <a class="underline break-words" href={source.url} rel="noreferrer" target="_blank">{source.title}</a>
      {source.date && <span>，{source.date}</span>}
      {source.accessed && <span>（访问：{source.accessed}）</span>}
    </li>)}
  </ol>
</section>}
