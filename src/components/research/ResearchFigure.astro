---
interface Props {
  src:string;
  alt:string;
  title:string;
  caption?:string;
  source?:string;
  sourceUrl?:string;
  asOf?:string;
  unit?:string;
}
const {src,alt,title,caption,source,sourceUrl,asOf,unit}=Astro.props;
---
<figure class="my-10 border border-[#d8d2c8] bg-white p-4 md:p-6">
  <div class="mb-4">
    <h3 class="font-serif text-lg font-bold text-ink-950">{title}</h3>
    {(unit || asOf) && <p class="mt-1 text-xs text-slate-400">{unit && <span>单位：{unit}</span>}{unit && asOf && <span> · </span>}{asOf && <span>截至：{asOf}</span>}</p>}
  </div>
  <img class="h-auto w-full" src={src} alt={alt} loading="lazy" decoding="async"/>
  {(caption || source) && <figcaption class="mt-4 border-t border-[#ebe7df] pt-3 text-xs leading-6 text-slate-500">
    {caption && <span>{caption}</span>}
    {caption && source && <span> </span>}
    {source && <span>来源：{sourceUrl ? <a class="institution-link" href={sourceUrl} target="_blank" rel="noreferrer">{source}</a> : source}</span>}
  </figcaption>}
</figure>
