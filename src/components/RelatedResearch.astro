---
import ResearchCard from './ResearchCard.astro';
import { withBase } from '../lib/paths';
import type { PublishedResearchEntry } from '../lib/research';

interface Props { entries: PublishedResearchEntry[] }
const {entries}=Astro.props;
---
{entries.length>0 && <aside class="institution-container pb-16" aria-labelledby="related-heading">
  <div class="institution-eyebrow mb-3">Related Research</div>
  <h2 id="related-heading" class="mb-6 font-serif text-2xl font-bold text-ink-950">相关阅读</h2>
  <div class="grid gap-6 md:grid-cols-3">{entries.map(entry=>
    <ResearchCard entry={entry} href={withBase('research/'+entry.id+'/')}/>
  )}</div>
</aside>}
