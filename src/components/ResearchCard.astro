---
import type { PublishedResearchEntry } from '../lib/research';

interface Props {
  entry: PublishedResearchEntry;
  href?: string;
}

const {entry,href='#'}=Astro.props;
const data=entry.data;
---
<article
  class="institution-card group flex h-full flex-col p-6 transition duration-200 hover:-translate-y-0.5 hover:border-gold-400/70 focus-within:border-gold-500"
  data-report-card={entry.id}
  data-report-number={data.reportNumber}
>
  <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] uppercase tracking-[.08em] text-slate-400">
    <span class="font-semibold text-gold-700">{data.category}</span>
    <span>{data.reportNumber}</span>
    <time datetime={data.date.toISOString()}>{data.date.toISOString().slice(0,10)}</time>
    {data.updated && <span title={'更新于 '+data.updated.toISOString().slice(0,10)}>已更新</span>}
  </div>
  <h3 class="font-serif text-xl font-bold leading-8 text-ink-950">
    <a class="transition group-hover:text-gold-700 focus-visible:text-gold-700" href={href}>{data.title}</a>
  </h3>
  <p class="mt-3 flex-1 text-sm leading-7 text-slate-600">{data.summary}</p>
  <div class="mt-5 text-xs font-semibold tracking-wide text-ink-800">阅读全文 →</div>
</article>
