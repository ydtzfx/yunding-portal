---
interface Props { title:string; category:string; summary:string; reportNumber?:string; date?:Date; href?:string }
const {title,category,summary,reportNumber,date,href='#'}=Astro.props;
---
<article class="bg-white rounded-xl shadow p-6">
  <div class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-slate-500 mb-2">
    <span class="text-amber-600 font-medium">{category}</span>
    {reportNumber && <span>{reportNumber}</span>}
    {date && <time datetime={date.toISOString()}>{date.toISOString().slice(0,10)}</time>}
  </div>
  <h3 class="font-semibold text-lg mb-2"><a href={href}>{title}</a></h3>
  <p class="text-slate-600 text-sm">{summary}</p>
</article>
