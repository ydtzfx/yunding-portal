---
import { company } from '../data/company';
import { withBase } from '../lib/paths';
const nav=[['','首页'],['about/','关于我们'],['research/','研究观点'],['methodology/','研究方法'],['team/','研究团队'],['contact/','联系我们']];
const current=Astro.url.pathname;
const isActive=(href:string)=>href==='' ? current===withBase() : current.startsWith(withBase(href));
const mark=withBase('brand/logo-mark.svg');
---
<header class="sticky top-0 z-50 border-b border-white/10 bg-ink-950 text-white">
  <div class="institution-container flex min-h-18 items-center justify-between gap-4 py-3">
    <a href={withBase()} class="flex min-w-0 items-center gap-3" aria-label={company.name+'首页'}>
      <img src={mark} alt="" width="36" height="36" class="size-9 shrink-0" aria-hidden="true"/>
      <span class="min-w-0">
        <span class="block truncate text-[15px] font-semibold tracking-wide">{company.name}</span>
        <span class="hidden text-[10px] uppercase tracking-[.18em] text-white/45 sm:block">{company.englishName}</span>
      </span>
    </a>

    <nav aria-label="主导航" class="hidden md:block">
      <div class="flex items-center gap-1 whitespace-nowrap">
        {nav.map(([href,label])=><a
          href={withBase(href)}
          aria-current={isActive(href) ? 'page' : undefined}
          class:list={[
            'rounded-sm px-3 py-2 text-xs font-medium tracking-wide transition',
            isActive(href) ? 'bg-white/8 text-gold-400' : 'text-white/68 hover:bg-white/5 hover:text-white'
          ]}
        >{label}</a>)}
      </div>
    </nav>

    <details class="mobile-nav relative md:hidden">
      <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 border border-white/15 px-3 text-xs font-semibold tracking-wide text-white/85 hover:border-white/30 hover:bg-white/5">
        <span>菜单</span>
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
      </summary>
      <nav aria-label="移动端导航" class="absolute right-0 top-[calc(100%+0.65rem)] w-[min(19rem,calc(100vw-2rem))] border border-white/12 bg-ink-950 p-2 shadow-2xl">
        {nav.map(([href,label])=><a
          href={withBase(href)}
          aria-current={isActive(href) ? 'page' : undefined}
          class:list={[
            'block border-b border-white/8 px-4 py-3 text-sm last:border-0',
            isActive(href) ? 'bg-white/7 text-gold-400' : 'text-white/72 hover:bg-white/5 hover:text-white'
          ]}
        >{label}</a>)}
      </nav>
    </details>
  </div>
</header>
