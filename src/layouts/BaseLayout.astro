---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title:string; description?:string; canonical?:string; ogType?:'website'|'article' }
const {title,description='芸鼎投资研究院研究门户',canonical,ogType='website'}=Astro.props;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="description" content={description}/>
    <meta name="theme-color" content="#08141e"/>
    <link rel="canonical" href={canonicalURL}/>
    <meta property="og:type" content={ogType}/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonicalURL}/>
    <meta name="twitter:card" content="summary"/>
    <title>{title} - 芸鼎投资研究院</title>
    <slot name="head"/>
  </head>
  <body>
    <Header/>
    <main><slot/></main>
    <Footer/>
  </body>
</html>
