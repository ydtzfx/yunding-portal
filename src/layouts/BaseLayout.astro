---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/paths';
import { company } from '../data/company';

interface Props { title:string; description?:string; canonical?:string; ogType?:'website'|'article'; ogImage?:string }

const {title,description=company.description,canonical,ogType='website',ogImage}=Astro.props;
const siteURL=new URL(withBase(),Astro.site);
const canonicalURL=canonical ?? new URL(Astro.url.pathname,Astro.site).toString();
const ogImageURL=ogImage
  ? (/^https?:\/\//.test(ogImage) ? ogImage : new URL(withBase(ogImage),Astro.site).toString())
  : new URL(withBase('brand/og-default.png'),Astro.site).toString();
const organizationId=siteURL.toString()+'#organization';
const organizationJsonLd={
  '@context':'https://schema.org',
  '@type':'Organization',
  '@id':organizationId,
  name:company.name,
  alternateName:company.englishBrandName,
  description:company.description,
  url:siteURL.toString(),
  logo:new URL(withBase('brand/logo-mark.svg'),Astro.site).toString(),
  email:company.contact.email,
  telephone:company.contact.phone,
  address:{
    '@type':'PostalAddress',
    streetAddress:company.contact.address,
    addressCountry:'CN',
  },
};
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="description" content={description}/>
    <meta name="theme-color" content="#08141e"/>
    <link rel="icon" type="image/svg+xml" href={withBase('brand/favicon.svg')}/>
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('brand/apple-touch-icon.png')}/>
    <link rel="canonical" href={canonicalURL}/>
    <meta property="og:type" content={ogType}/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonicalURL}/>
    <meta property="og:image" content={ogImageURL}/>
    <meta property="og:image:alt" content={company.name}/>
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/>
    <meta name="twitter:image" content={ogImageURL}/>
    <title>{title} - {company.name}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)}></script>
    <slot name="head"/>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <Header/>
    <main id="main-content" tabindex="-1"><slot/></main>
    <Footer/>
  </body>
</html>
