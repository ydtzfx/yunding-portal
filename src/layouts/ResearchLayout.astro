---
import BaseLayout from './BaseLayout.astro';
import SourceList from '../components/SourceList.astro';
import { withBase } from '../lib/paths';
interface Source { title:string; publisher:string; url:string; date?:string; accessed?:string }
interface Author { id:string; name:string; type:'Person'|'Organization'; role?:string; bio:string; url?:string }
interface Props {
  title:string; summary?:string; category?:string; reportNumber?:string;
  author:Author; publishedAt:Date; updatedAt?:Date; tags?:string[]; sources?:Source[];
}
const {title,summary,category,reportNumber,author,publishedAt,updatedAt,tags=[],sources=[]}=Astro.props;
const canonicalURL=new URL(Astro.url.pathname,Astro.site).toString();
const authorPath=withBase('research/authors/'+author.id+'/');
const authorURL=author.url ?? new URL(authorPath,Astro.site).toString();
const jsonLd={
  '@context':'https://schema.org',
  '@type':'Article',
  headline:title,
  description:summary,
  identifier:reportNumber,
  datePublished:publishedAt.toISOString(),
  dateModified:(updatedAt ?? publishedAt).toISOString(),
  mainEntityOfPage:{'@type':'WebPage','@id':canonicalURL},
  keywords:tags,
  author:{'@type':author.type,name:author.name,url:authorURL},
  publisher:{'@type':'Organization',name:'芸鼎投资研究院',url:new URL(withBase(),Astro.site).toString()},
};
---
<BaseLayout title={title} description={summary} canonical={canonicalURL} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={publishedAt.toISOString()}/>
    <meta property="article:modified_time" content={(updatedAt ?? publishedAt).toISOString()}/>
    {tags.map(tag=><meta property="article:tag" content={tag}/>)}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </Fragment>

  <article>
    <header class="border-b border-[#d8d2c8] bg-[#f1eee7]">
      <div class="mx-auto max-w-4xl px-6 py-14 md:py-20">
        <div class="institution-eyebrow mb-5">{category ?? 'Research'}</div>
        <h1 class="max-w-4xl font-serif text-3xl font-bold leading-[1.35] text-ink-950 md:text-5xl">{title}</h1>
        {summary && <p class="mt-6 max-w-3xl text-base leading-8 text-slate-600 md:text-lg">{summary}</p>}
        <div class="mt-8 grid gap-3 border-t border-[#d4cec2] pt-5 text-xs text-slate-500 sm:grid-cols-2 lg:grid-cols-4">
          {reportNumber && <div><span class="block text-[10px] uppercase tracking-[.14em] text-slate-400">Report</span><span class="mt-1 block font-medium text-ink-900">{reportNumber}</span></div>}
          <div><span class="block text-[10px] uppercase tracking-[.14em] text-slate-400">Author</span><a class="institution-link mt-1 block font-medium" href={authorPath}>{author.name}</a></div>
          <div><span class="block text-[10px] uppercase tracking-[.14em] text-slate-400">Published</span><time class="mt-1 block font-medium text-ink-900" datetime={publishedAt.toISOString()}>{publishedAt.toISOString().slice(0,10)}</time></div>
          <div><span class="block text-[10px] uppercase tracking-[.14em] text-slate-400">Updated</span><time class="mt-1 block font-medium text-ink-900" datetime={(updatedAt ?? publishedAt).toISOString()}>{(updatedAt ?? publishedAt).toISOString().slice(0,10)}</time></div>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
      <div class="research-prose"><slot/></div>
      <SourceList sources={sources}/>
    </div>
  </article>
</BaseLayout>
