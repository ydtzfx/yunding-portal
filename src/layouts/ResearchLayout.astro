---
import BaseLayout from './BaseLayout.astro';
import SourceList from '../components/SourceList.astro';
interface Source { title:string; publisher:string; url:string; date?:string; accessed?:string }
interface Author { id:string; name:string; type:'Person'|'Organization'; role?:string; bio:string; url?:string }
interface Props {
  title:string; summary?:string; category?:string; reportNumber?:string;
  author:Author; publishedAt:Date; updatedAt?:Date; tags?:string[]; sources?:Source[];
}
const {title,summary,category,reportNumber,author,publishedAt,updatedAt,tags=[],sources=[]}=Astro.props;
const canonicalURL=new URL(Astro.url.pathname,Astro.site).toString();
const base=import.meta.env.BASE_URL;
const jsonLd={
  '@context':'https://schema.org',
  '@type':'Article',
  headline:title,
  description:summary,
  identifier:reportNumber,
  datePublished:publishedAt.toISOString(),
  dateModified:(updatedAt ?? publishedAt).toISOString(),
  mainEntityOfPage:canonicalURL,
  keywords:tags.join(', '),
  author:{'@type':author.type,name:author.name,url:author.url},
  publisher:{'@type':'Organization',name:'芸鼎投资研究院'},
};
---
<BaseLayout title={title} description={summary} canonical={canonicalURL}>
  <Fragment slot="head"><script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script></Fragment>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <div class="text-amber-600 text-sm mb-2">{category}</div>
    <h1 class="text-3xl font-bold mb-4">{title}</h1>
    <div class="text-sm text-slate-500 border-b border-slate-200 pb-6 mb-8 flex flex-wrap gap-x-4 gap-y-2">
      {reportNumber && <span>报告编号：{reportNumber}</span>}
      <span>作者：<a class="hover:underline" href={base+'research/authors/'+author.id+'/'}>{author.name}</a></span>
      <time datetime={publishedAt.toISOString()}>发布：{publishedAt.toISOString().slice(0,10)}</time>
      {updatedAt && <time datetime={updatedAt.toISOString()}>更新：{updatedAt.toISOString().slice(0,10)}</time>}
    </div>
    <slot/>
    <SourceList sources={sources}/>
  </article>
</BaseLayout>
