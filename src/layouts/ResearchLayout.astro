---
import BaseLayout from './BaseLayout.astro';
import SourceList from '../components/SourceList.astro';
import ReportHighlights from '../components/research/ReportHighlights.astro';
import AttachmentList from '../components/research/AttachmentList.astro';
import { withBase } from '../lib/paths';
import type { AuthorEntry, PublishedResearchEntry } from '../lib/research';
import { company } from '../data/company';

interface Props {
  entry: PublishedResearchEntry;
  author: AuthorEntry;
}

const {entry,author}=Astro.props;
const data=entry.data;
const summary=data.description ?? data.summary;
const canonicalURL=new URL(Astro.url.pathname,Astro.site).toString();
const authorPath=withBase('research/authors/'+author.id+'/');
const authorURL=author.data.url ?? new URL(authorPath,Astro.site).toString();
const organizationId=new URL(withBase(),Astro.site).toString()+'#organization';
const jsonLd={
  '@context':'https://schema.org',
  '@type':'Article',
  headline:data.title,
  description:summary,
  identifier:data.reportNumber,
  datePublished:data.date.toISOString(),
  ...(data.updated ? {dateModified:data.updated.toISOString()} : {}),
  mainEntityOfPage:{'@type':'WebPage','@id':canonicalURL},
  keywords:data.tags,
  author:{'@type':author.data.type,name:author.data.name,url:authorURL},
  publisher:{'@id':organizationId,name:company.name},
};
---
<BaseLayout title={data.title} description={summary} canonical={canonicalURL} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={data.date.toISOString()}/>
    {data.updated && <meta property="article:modified_time" content={data.updated.toISOString()}/>}
    {data.tags.map(tag=><meta property="article:tag" content={tag}/>)}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </Fragment>

  <article
    data-report-id={entry.id}
    data-report-number={data.reportNumber}
    data-author-id={data.authorId}
    data-published={data.date.toISOString().slice(0,10)}
    data-updated={data.updated?.toISOString().slice(0,10) ?? ''}
    data-source-count={String(data.sources.length)}
    data-attachment-count={String(data.attachments.length)}
    data-highlight-count={String(data.highlights.length)}
  >
    <header class="border-b border-[#d8d2c8] bg-[#f1eee7]">
      <div class="mx-auto max-w-4xl px-6 py-14 md:py-20">
        <div class="institution-eyebrow mb-5">{data.category}</div>
        <h1 class="max-w-4xl font-serif text-3xl font-bold leading-[1.35] text-ink-950 md:text-5xl">{data.title}</h1>
        <p class="mt-6 max-w-3xl text-base leading-8 text-slate-600 md:text-lg">{summary}</p>
        <div class:list={[
          'mt-8 grid gap-3 border-t border-[#d4cec2] pt-5 text-xs text-slate-500 sm:grid-cols-2',
          data.updated ? 'lg:grid-cols-4' : 'lg:grid-cols-3'
        ]}>
          <div><span class="block text-[10px] uppercase tracking-[.14em] text-slate-400">Report</span><span class="mt-1 block font-medium text-ink-900">{data.reportNumber}</span></div>
          <div><span class="block text-[10px] uppercase tracking-[.14em] text-slate-400">Author</span><a class="institution-link mt-1 block font-medium" href={authorPath}>{author.data.name}</a></div>
          <div><span class="block text-[10px] uppercase tracking-[.14em] text-slate-400">Published</span><time class="mt-1 block font-medium text-ink-900" datetime={data.date.toISOString()}>{data.date.toISOString().slice(0,10)}</time></div>
          {data.updated && <div><span class="block text-[10px] uppercase tracking-[.14em] text-slate-400">Updated</span><time class="mt-1 block font-medium text-ink-900" datetime={data.updated.toISOString()}>{data.updated.toISOString().slice(0,10)}</time></div>}
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
      <ReportHighlights highlights={data.highlights}/>
      <div class="research-prose"><slot/></div>
      <AttachmentList attachments={data.attachments}/>
      <SourceList sources={data.sources}/>
    </div>
  </article>
</BaseLayout>
